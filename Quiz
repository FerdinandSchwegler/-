function LearningModule({ module }) {
  const [answers, setAnswers] = React.useState({});
  const [submitted, setSubmitted] = React.useState(false);

  const score = module.quiz.filter(
    (q, i) => answers[i] === q.answer
  ).length;

  return (
    <section className="bg-white/5 border border-white/10 rounded-3xl p-8 shadow-2xl backdrop-blur-xl">
      <div className="mb-8">
        <h2 className="text-4xl font-bold text-amber-100 mb-2">
          {module.title}
        </h2>
        <p className="text-slate-300 italic text-lg">{module.subtitle}</p>
      </div>

      <div className="prose prose-invert max-w-none leading-8 text-lg">
        {module.text.split('\n').map((paragraph, i) => (
          <p key={i}>{paragraph}</p>
        ))}
      </div>

      <div className="mt-12">
        <h3 className="text-3xl font-semibold mb-6 text-amber-200">
          Wissensquiz
        </h3>

        <div className="space-y-8">
          {module.quiz.map((q, i) => (
            <div
              key={i}
              className={`rounded-2xl border p-6 transition-all ${
                submitted && answers[i] !== q.answer
                  ? 'border-red-400 bg-red-500/10'
                  : 'border-white/10 bg-black/20'
              }`}
            >
              <h4 className="text-xl font-semibold mb-4">
                {i + 1}. {q.question}
              </h4>

              <div className="space-y-3">
                {q.options.map((option, optionIndex) => (
                  <label
                    key={optionIndex}
                    className="flex items-center gap-3 cursor-pointer text-slate-200"
                  >
                    <input
                      type="radio"
                      name={`question-${i}`}
                      checked={answers[i] === optionIndex}
                      onChange={() =>
                        setAnswers({ ...answers, [i]: optionIndex })
                      }
                    />
                    <span>
                      {String.fromCharCode(65 + optionIndex)}. {option}
                    </span>
                  </label>
                ))}
              </div>

              {submitted && answers[i] !== q.answer && (
                <div className="mt-6 p-4 rounded-xl bg-red-500/20 border border-red-400">
                  <p className="font-semibold text-red-200 mb-2">
                    Relevante Lernpassage:
                  </p>
                  <p className="text-slate-200 italic">“{q.reference}”</p>
                </div>
              )}
            </div>
          ))}
        </div>

        <button
          onClick={() => setSubmitted(true)}
          className="mt-8 px-8 py-4 rounded-2xl bg-amber-300 text-slate-900 font-bold text-lg hover:scale-105 transition-transform"
        >
          Quiz auswerten
        </button>

        {submitted && (
          <div className="mt-8 p-6 rounded-2xl bg-emerald-500/10 border border-emerald-400">
            <h4 className="text-2xl font-bold text-emerald-200 mb-2">
              Ergebnis
            </h4>
            <p className="text-lg text-slate-200">
              Du hast {score} von {module.quiz.length} Fragen richtig beantwortet.
            </p>
          </div>
        )}
      </div>
    </section>
  );
}
