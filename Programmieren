// ─── HELPERS ──────────────────────────────────────────────────────────────────
function h1(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_1,
    children: [new TextRun({ text, font: "Arial", size: 36, bold: true, color: C.navy })],
    spacing: { before: 480, after: 240 },
  });
}
function h2(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_2,
    children: [new TextRun({ text, font: "Arial", size: 28, bold: true, color: C.accent })],
    spacing: { before: 360, after: 180 },
  });
}
function h3(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_3,
    children: [new TextRun({ text, font: "Arial", size: 24, bold: true, color: C.steel })],
    spacing: { before: 240, after: 120 },
  });
}
function p(text, opts = {}) {
  return new Paragraph({
    children: [new TextRun({ text, font: "Arial", size: 22, color: C.steel, ...opts })],
    spacing: { after: 160 },
  });
}
function pBold(text) {
  return p(text, { bold: true });
}
function bullet(text, level = 0) {
  return new Paragraph({
    numbering: { reference: "bullets", level },
    children: [new TextRun({ text, font: "Arial", size: 22, color: C.steel })],
    spacing: { after: 100 },
  });
}
function numbered(text, level = 0) {
  return new Paragraph({
    numbering: { reference: "numbers", level },
    children: [new TextRun({ text, font: "Arial", size: 22, color: C.steel })],
    spacing: { after: 100 },
  });
}
function code(text) {
  return new Paragraph({
    children: [new TextRun({ text, font: "Courier New", size: 19, color: C.code })],
    shading: { fill: C.codeBg, type: ShadingType.CLEAR },
    spacing: { after: 80, before: 80 },
    indent: { left: 360 },
    border: {
      left: { style: BorderStyle.SINGLE, size: 6, color: C.cyan },
    }
  });
}
function note(text) {
  return new Paragraph({
    children: [
      new TextRun({ text: "  Hinweis: ", font: "Arial", size: 20, bold: true, color: C.cyan }),
      new TextRun({ text, font: "Arial", size: 20, color: C.steel, italics: true }),
    ],
    shading: { fill: C.light, type: ShadingType.CLEAR },
    spacing: { after: 120, before: 120 },
    indent: { left: 180 },
  });
}
function warn(text) {
  return new Paragraph({
    children: [
      new TextRun({ text: "  Achtung: ", font: "Arial", size: 20, bold: true, color: C.coral }),
      new TextRun({ text, font: "Arial", size: 20, color: C.steel }),
    ],
    shading: { fill: "FFF3F3", type: ShadingType.CLEAR },
    spacing: { after: 120, before: 120 },
    indent: { left: 180 },
  });
}
function spacer(n = 1) {
  return Array.from({ length: n }, () =>
    new Paragraph({ children: [new TextRun("")], spacing: { after: 80 } })
  );
}
function pageBreak() {
  return new Paragraph({ children: [new PageBreak()] });
}
function divider() {
  return new Paragraph({
    children: [new TextRun("")],
    border: { bottom: { style: BorderStyle.SINGLE, size: 2, color: C.border } },
    spacing: { after: 200, before: 200 },
  });
}

// Coloured info box
function infoBox(label, text, bgColor = C.light) {
  return new Table({
    width: { size: 9360, type: WidthType.DXA },
    columnWidths: [9360],
    rows: [
      new TableRow({
        children: [
          new TableCell({
            borders: { top: { style: BorderStyle.SINGLE, size: 6, color: C.cyan }, bottom: noBorder, left: noBorder, right: noBorder },
            shading: { fill: bgColor, type: ShadingType.CLEAR },
            margins: { top: 120, bottom: 120, left: 240, right: 240 },
            width: { size: 9360, type: WidthType.DXA },
            children: [
              new Paragraph({ children: [new TextRun({ text: label, font: "Arial", size: 20, bold: true, color: C.accent })], spacing: { after: 60 } }),
              new Paragraph({ children: [new TextRun({ text, font: "Arial", size: 20, color: C.steel })], spacing: { after: 0 } }),
            ],
          })
        ]
      })
    ]
  });
}

// Reference entry table (Module 3)
function refEntry(name, syntax, erklaerung, anwendung, beispiel, fehler, hinweis) {
  const cellStyle = (txt, bold = false, isCode = false) => new TableCell({
    borders,
    margins: { top: 80, bottom: 80, left: 120, right: 120 },
    children: [new Paragraph({ children: [new TextRun({ text: txt, font: isCode ? "Courier New" : "Arial", size: isCode ? 18 : 20, bold, color: isCode ? C.code : C.steel })] })]
  });
  const labelCell = (txt) => new TableCell({
    borders,
    shading: { fill: C.light, type: ShadingType.CLEAR },
    margins: { top: 80, bottom: 80, left: 120, right: 120 },
    width: { size: 2000, type: WidthType.DXA },
    children: [new Paragraph({ children: [new TextRun({ text: txt, font: "Arial", size: 19, bold: true, color: C.accent })] })]
  });
  const dataCell = (txt, isCode = false) => new TableCell({
    borders,
    margins: { top: 80, bottom: 80, left: 120, right: 120 },
    width: { size: 7360, type: WidthType.DXA },
    children: [new Paragraph({ children: [new TextRun({ text: txt, font: isCode ? "Courier New" : "Arial", size: isCode ? 18 : 20, color: isCode ? C.code : C.steel })] })]
  });

  return [
    new Table({
      width: { size: 9360, type: WidthType.DXA },
      columnWidths: [2000, 7360],
      rows: [
        new TableRow({ children: [
          new TableCell({ borders, shading: { fill: C.navy, type: ShadingType.CLEAR }, columnSpan: 2,
            margins: { top: 100, bottom: 100, left: 180, right: 180 },
            children: [new Paragraph({ children: [new TextRun({ text: name, font: "Arial", size: 22, bold: true, color: C.white })] })] })
        ]}),
        new TableRow({ children: [labelCell("Syntax"), dataCell(syntax, true)] }),
        new TableRow({ children: [labelCell("Funktion"), dataCell(erklaerung)] }),
        new TableRow({ children: [labelCell("Anwendung"), dataCell(anwendung)] }),
        new TableRow({ children: [labelCell("Beispiel"), dataCell(beispiel, true)] }),
        new TableRow({ children: [labelCell("Fehlerquelle"), dataCell(fehler)] }),
        new TableRow({ children: [labelCell("Hinweis"), dataCell(hinweis)] }),
      ]
    }),
    new Paragraph({ children: [new TextRun("")], spacing: { after: 160 } }),
  ];
}

