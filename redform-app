body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0a0a0a;
  color: #fff;
}

h1, h2, h3 {
  color: #ff2b2b;
  text-shadow: 0 0 10px #ff2b2b;
}

.container {
  padding: 20px;
  max-width: 1100px;
  margin: auto;
}

.hero {
  text-align: center;
  padding: 120px 20px;
}

.hero h1 {
  font-size: 60px;
}

.btn {
  background: #ff2b2b;
  border: none;
  padding: 15px 30px;
  color: white;
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 0 15px #ff2b2b;
  transition: 0.2s;
  border-radius: 8px;
}

.btn:hover {
  transform: scale(1.05);
  box-shadow: 0 0 25px #ff2b2b;
}

.section {
  display: none;
}

.active {
  display: block;
}

.card {
  background: #111;
  padding: 20px;
  margin: 20px 0;
  border-radius: 12px;
  box-shadow: 0 0 10px rgba(255,43,43,0.2);
}

input, select {
  padding: 12px;
  margin: 10px 0;
  width: 100%;
  background: #000;
}
